# =============================================================
# MAINTTECH JOBS MAROC - ENVIRONMENT CONFIGURATION
# Copy to .env and configure for your local or cloud deployment
# =============================================================

# Flask Application Secret Key (generate a secure random string)
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Application Port (automatically set by Cloud Run, Render, Heroku)
PORT=5000

# Database Configuration
# Local SQLite default:
# DATABASE_URL=sqlite:///mainttech.db
# Cloud PostgreSQL example:
DATABASE_URL=postgresql://mainttech:mainttech_secure_pass_2026@db:5432/mainttech_db

# Auto Seed database with Moroccan maintenance technicians on first run (true / false)
AUTO_SEED=true

# Security Settings
# Set to 'true' in production when running behind HTTPS/SSL
SESSION_COOKIE_SECURE=false

# Cloud Reverse Proxy Handling (AWS ALB, GCP Cloud Run, Nginx, Traefik)
USE_PROXY_FIX=true

# Gunicorn Production WSGI Workers
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
